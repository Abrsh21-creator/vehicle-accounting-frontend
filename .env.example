# API Configuration
# Update this with your Render backend URL after deployment
VITE_API_URL=http://localhost:3001/api

# For production (Vercel), set this in Vercel Environment Variables:
# VITE_API_URL=https://vehicle-accounting-api.onrender.com/api

# Supabase Configuration (for cloud database sync)
# Get these values from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
